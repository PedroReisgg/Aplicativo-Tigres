# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# E-mail (código de 2 etapas e relatórios). Use UMA das opções:
# Opção A, Gmail: crie uma "senha de app" em https://myaccount.google.com/apppasswords
SMTP_USER=
SMTP_PASS=
# Opção B, Resend: exige um domínio verificado para enviar a qualquer pessoa
RESEND_API_KEY=
EMAIL_FROM="Tigres do Riacho <app@seudominio.com.br>"

# Endereço público do site (usado nos e-mails)
NEXT_PUBLIC_SITE_URL=https://tigresapp.vercel.app

# Coloque "off" para desligar o código por e-mail (ex.: enquanto não houver domínio no Resend)
AUTH_2FA=on
